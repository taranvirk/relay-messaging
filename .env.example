# Host development defaults: copy to backend/.env.
# Compose supplies its own local defaults; optional AWS settings can use a root .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://relay:relay@127.0.0.1:5432/relay?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
LOG_LEVEL=info
AWS_REGION=us-east-1
ATTACHMENTS_BUCKET=
QUEUE_URL=
VITE_API_URL=
